package { name = "fettle", version = "0.0.1", description = "Agentless configuration management with its own typed, total language", avin = "0.0.35" }

dependencies {
  json { git = "github.com/avin-lang/json", version = "0.0.3" }
  parsing { git = "github.com/avin-lang/parsing", version = "0.6.0" }
  ssh { git = "github.com/avin-lang/ssh", version = "0.0.1" }
}

c-libraries {
  sodium {
    pkg-config = "libsodium"
    headers    = ["<sodium.h>"]
    install    = "libsodium 1.0.18 or later: `brew install libsodium`; Debian's libsodium-dev"
  }
  libc { headers = ["<sys/stat.h>"] }
}

// One block: a second `c-linking` would replace this list rather than add to it.
c-linking {
  static = ["sodium", "ssh/libssh2"]
}
