module dev.avinlang.fettle.cli

import avin.fs
import avin.io
import avin.process
import dev.avinlang.fettle.vault
import dev.avinlang.fettle.vault.{Editing, Sources, Vaults, editorOf}
import dev.avinlang.fettle.syntax.{Diagnostic, parseSource}
import dev.avinlang.fettle.report.{render}
import dev.avinlang.fettle.project.{Project, checkProject, filesUnder, load}
import dev.avinlang.fettle.fmt.{format}
import dev.avinlang.fettle.eval.{evaluate}
import dev.avinlang.fettle.facts.{factsJson, gather, readFacts, showFacts}
import dev.avinlang.fettle.graph.{showGraph}
import dev.avinlang.fettle.hosts.{Reach, adHoc, inInventory, reachOf as hostReach}
import dev.avinlang.fettle.transport.{ChangedKey, KnownKey, LocalTransport, NoBecome, PinnedKey, UnknownKey, connectSsh, hostKeyOf, trustHostKey}
import dev.avinlang.ssh

val usage: string = "usage: fettle check [<vault options>] [dir]\n       fettle fmt [--check] [files…]\n       fettle graph --facts <fixture.json> --host <name> [<vault options>] [dir]\n       fettle facts --local [--json]\n       fettle facts <host> [--json] [--dir d] [--ssh-config f] [--known-hosts f] [--accept-new]\n       fettle trust <host> [--yes] [--dir d] [--ssh-config f] [--known-hosts f]\n       fettle plan --local [--host <name>] [<vault options>] [dir]\n       fettle apply --local [--host <name>] [--yes] [<vault options>] [dir]\n       fettle vault create|edit|view|encrypt|decrypt|rekey [<vault options>] <file>\n<vault options> are --vault-password-file <file> and --vault-password-command <command>; rekey also\ntakes --new-vault-password-file <file>"

// Runs the command `args` names, answering the exit status.
main(args: Vector[string]) -> int
  if args.isEmpty
    eprintln(usage)
    return 2
  val rest = args.drop(1)
  args(0) match
    "check" -> check(rest)
    "fmt" -> fmt(rest)
    "graph" -> graph(rest)
    "facts" -> facts(rest)
    "trust" -> trust(rest)
    "plan" -> plan(rest)
    "apply" -> apply(rest)
    "vault" -> vaultCommand(rest)
    _ ->
      eprintln(s"fettle: unknown command `${args(0)}`\n$usage")
      2

// Renders `ds` on standard error against the project's texts, answering the number of errors.
private report(p: Project, ds: Iterable[Diagnostic]) -> int
  var errors = 0
  for d in ds
    eprint(render(d, p.textOf(d.span.file)))
    if !d.warning then errors += 1
  errors

private loaded(dir: string) -> Option[Project] = load(dir) match
  Ok(p) -> Some(p)
  Err(e) ->
    eprintln(s"fettle: $e")
    None

// The vault options of `args` read out of them: the passphrase's sources and the arguments left.
// `None` where an option has no value.
private vaultOptions(args: Vector[string]) -> Option[(VaultOptions, Vector[string])]
  var file: Option[string] = None
  var command: Option[string] = None
  var next: Option[string] = None
  val rest = Buffer[string]()
  var i = 0
  while i < args.length
    val a = args(i)
    if a == "--vault-password-file" || a == "--vault-password-command" || a == "--new-vault-password-file"
      if i + 1 >= args.length
        eprintln(s"fettle: `$a` needs a value\n$usage")
        return None
      val v = Some(args(i + 1))
      a match
        "--vault-password-file" -> file = v
        "--vault-password-command" -> command = v
        _ -> next = v
      i += 2
    else
      rest += a
      i += 1
  val sources = Sources(file, command, process.env("FETTLE_VAULT_PASSWORD"), prompt)
  val nextSources = Sources(next, None, None, prompt)
  Some((VaultOptions(sources, nextSources), rest.toVector))

// The passphrase sources of a run: the one a vault is opened with, and for `rekey` the new one.
data VaultOptions(sources: Sources, next: Sources)

// Asks at the terminal without echo.
private prompt(question: string) -> Result[string, string] = io.readSecret(question).mapErr(e -> s"$e")

// `fettle check [<vault options>] [dir]`: every file of the project in `dir` checked, its diagnostics
// rendered with excerpts. Fails when any is an error. A vault's names are checked when a passphrase is
// at hand without asking; otherwise they wait for the run that opens it.
check(args: Vector[string]) -> int
  val (opts, rest) = vaultOptions(args) match
    Some(x) -> x
    None -> return 2
  val dir = if rest.isEmpty then "." else rest(0)
  val p = loaded(dir) match
    Some(x) -> x
    None -> return 1
  val vaults = Vaults(dir, opts.sources, false)
  if report(p, checkProject(p, f -> vaults.names(f))) > 0 then 1 else 0

// `fettle fmt [--check] [files…]`: each file written in its canonical form, or with `--check` only
// named when it is not in it. With no files, every `.fettle` file under the current directory.
fmt(args: Vector[string]) -> int
  val checkOnly = args.contains("--check")
  val given = args.filter(a -> a != "--check")
  val names: Vector[string] = if given.isEmpty then filesUnder(".", "", ".fettle").toVector else given
  var status = 0
  for name in names
    val text = fs.readText(name) match
      Ok(t) -> t
      Err(e) ->
        eprintln(s"fettle: $e")
        status = 1
        continue
    val parsed = parseSource(name, text)
    val errors = parsed.diagnostics.filter(d -> !d.warning)
    if !errors.isEmpty
      for d in errors
        eprint(render(d, text))
      status = 1
      continue
    val formatted = format(parsed.file)
    if formatted != text
      if checkOnly
        println(name)
        status = 1
      else
        fs.writeText(name, formatted) match
          Ok(_) -> ()
          Err(e) ->
            eprintln(s"fettle: $e")
            status = 1
  status

// `fettle graph --facts <fixture.json> --host <name> [dir]`: the project checked, then evaluated
// for one host against the facts in a fixture, and its graph printed.
graph(given: Vector[string]) -> int
  val (opts, args) = vaultOptions(given) match
    Some(x) -> x
    None -> return 2
  var facts = ""
  var host = ""
  var dir = "."
  var i = 0
  while i < args.length
    args(i) match
      "--facts" if i + 1 < args.length ->
        facts = args(i + 1)
        i += 2
      "--host" if i + 1 < args.length ->
        host = args(i + 1)
        i += 2
      a ->
        dir = a
        i += 1
  if facts.isEmpty || host.isEmpty
    eprintln(usage)
    return 2
  val p = loaded(dir) match
    Some(x) -> x
    None -> return 1
  val vaults = Vaults(dir, opts.sources, true)
  if report(p, checkProject(p, x -> vaults.names(x))) > 0 then return 1
  val f = fs.readText(facts).mapErr(e -> s"$e").flatMap(t -> readFacts(t)) match
    Ok(x) -> x
    Err(e) ->
      eprintln(s"fettle: $facts: $e")
      return 1
  val e = evaluate(p.files, host, f, x -> p.read(x), p.templates, x -> vaults.names(x))
  if report(p, e.diagnostics) > 0 then return 1
  print(showGraph(e.graph))
  0

// `fettle vault <command> [<vault options>] <file>`.
vaultCommand(given: Vector[string]) -> int
  val (opts, args) = vaultOptions(given) match
    Some(x) -> x
    None -> return 2
  if args.length != 2
    eprintln(usage)
    return 2
  val file = args(1)
  val editing = Editing(editorOf(n -> process.env(n)), question -> askAgain(question))
  val done: Result[unit, string] = args(0) match
    "create" -> vault.create(file, opts.sources, editing)
    "edit" -> vault.edit(file, opts.sources, editing)
    "view" -> vault.view(file, opts.sources).map(t -> print(t))
    "encrypt" -> vault.encrypt(file, opts.sources)
    "decrypt" -> vault.decrypt(file, opts.sources)
    "rekey" -> vault.rekey(file, opts.sources, opts.next)
    other ->
      eprintln(s"fettle: `vault` has no command `$other`\n$usage")
      return 2
  done match
    Ok(_) -> 0
    Err(e) ->
      eprintln(s"fettle: $e")
      1

// Asks `question` at the terminal and answers whether the reply is yes, which an empty reply is.
private askAgain(question: string) -> bool
  eprint(question)
  io.readLine() match
    Some(line) ->
      val reply = line.trim.toLower
      reply.isEmpty || reply == "y" || reply == "yes"
    None -> false

// `fettle facts --local [--json]`: this machine's facts, gathered by running the facts script under
// `/bin/sh`, printed one a line or, with `--json`, as the JSON a fact fixture holds. `fettle facts
// <host>`: the facts of a host of the inventory in `--dir` (the current directory by default), or of
// one named `[user@]host[:port]`, gathered over SSH as its login user.
facts(args: Vector[string]) -> int = factsText(args) match
  Ok(text) ->
    print(text)
    0
  Err((code, message)) ->
    eprintln(message)
    code

// What the commands that reach a host were given: the host, and the options.
data Remote(
  name: string = "",
  dir: string = ".",
  dirGiven: bool = false,
  sshConfig: Option[string] = None,
  knownHosts: Option[string] = None,
  acceptNew: bool = false,
  json: bool = false,
  yes: bool = false,
  local: bool = false
)

// `args` read as the options `flags` allows (of `--json`, `--local`, `--yes`, `--accept-new`, `--dir`,
// `--ssh-config`, `--known-hosts`) and one host, or the usage error.
remoteArgs(args: Vector[string], flags: Vector[string]) -> Result[Remote, string]
  var r = Remote()
  var i = 0
  while i < args.length
    val a = args(i)
    val valued = a == "--dir" || a == "--ssh-config" || a == "--known-hosts"
    if a.startsWith("-") && !flags.contains(a) then return Err(s"fettle: unknown argument `$a`")
    if valued
      if i + 1 >= args.length then return Err(s"fettle: `$a` needs a value")
      val v = args(i + 1)
      r = a match
        "--dir" -> r with { dir = v, dirGiven = true }
        "--ssh-config" -> r with { sshConfig = Some(v) }
        _ -> r with { knownHosts = Some(v) }
      i += 2
      continue
    r = a match
      "--json" -> r with { json = true }
      "--local" -> r with { local = true }
      "--yes" -> r with { yes = true }
      "--accept-new" -> r with { acceptNew = true }
      _ ->
        if r.name.nonEmpty then return Err(s"fettle: one host at a time, not `${r.name}` and `$a`")
        r with { name = a }
    i += 1
  Ok(r)

// What `fettle facts` prints for `args`, or the exit status and message it fails with.
factsText(args: Vector[string]) -> Result[string, (int, string)]
  val r = remoteArgs(args, ["--local", "--json", "--dir", "--ssh-config", "--known-hosts", "--accept-new"]).mapErr(e -> (2, s"$e\n$usage"))?
  if r.local && r.name.nonEmpty then return Err((2, s"fettle: --local takes no host, and `${r.name}` was given\n$usage"))
  if !r.local && r.name.isEmpty then return Err((2, s"fettle: facts needs a host, or --local\n$usage"))
  val gathered = if r.local
    val t = LocalTransport()
    val f = gather(t).mapErr(e -> s"fettle: local: $e")
    _ = t.close()
    f
  else
    val (reach, config) = reachOf(r).mapErr(e -> (1, e))?
    val t = connectSsh(reach.target, config).mapErr(e -> (1, s"fettle: ${e.message}"))?
    val f = gather(t).mapErr(e -> s"fettle: ${r.name}: $e")
    _ = t.close()
    f
  gathered match
    Ok(f) -> Ok(if r.json then factsJson(f) + "\n" else showFacts(f))
    Err(e) -> Err((1, e))

// How to reach the host `r` names, and the SSH configuration: a host of the inventory in `r.dir`
// where it holds one by that name, otherwise `[user@]host[:port]`, an alias of the configuration among
// them. The command line's known-hosts file and `--accept-new` go over what the inventory says.
reachOf(r: Remote) -> Result[(Reach, ssh.SshConfig), string]
  val config = (r.sshConfig match
    Some(f) -> ssh.SshConfig.read(f)
    None -> ssh.SshConfig.load()).mapErr(e -> s"fettle: ${e.message}")?
  val inventory: Option[Project] = if r.name.contains("@") then None else load(r.dir) match
    Ok(p) -> if inInventory(p.files, r.name) then Some(p) else None
    Err(e) -> if r.dirGiven then return Err(s"fettle: $e") else None
  val reach = inventory match
    Some(p) ->
      if report(p, checkProject(p)) > 0 then return Err(s"fettle: the project in ${r.dir} has errors")
      hostReach(p.files, r.name).mapErr(e -> s"fettle: $e")?
    None -> Reach(adHoc(r.name).mapErr(e -> s"fettle: $e")?, NoBecome)
  val target = reach.target with {
    knownHosts = r.knownHosts.orElse(reach.target.knownHosts),
    acceptNew = r.acceptNew || reach.target.acceptNew
  }
  Ok((reach with { target = target }, config))

// `fettle trust <host> [--yes]`: the host's key fingerprint shown and, once confirmed (or at once
// with `--yes`), added to the known-hosts file. A key already known, or pinned by the inventory, is
// left alone; a changed one is refused.
trust(args: Vector[string]) -> int
  val r = remoteArgs(args, ["--yes", "--dir", "--ssh-config", "--known-hosts"]) match
    Ok(x) -> x
    Err(e) ->
      eprintln(s"$e\n$usage")
      return 2
  if r.name.isEmpty
    eprintln(s"fettle: trust needs a host\n$usage")
    return 2
  val (reach, config) = reachOf(r) match
    Ok(x) -> x
    Err(e) ->
      eprintln(e)
      return 1
  val state = hostKeyOf(reach.target, config) match
    Ok(s) -> s
    Err(e) ->
      eprintln(s"fettle: ${e.message}")
      return 1
  state match
    KnownKey(fp) ->
      println(s"${r.name}: the key $fp is already known")
      0
    PinnedKey(fp) ->
      println(s"${r.name}: the inventory pins the key $fp; nothing is recorded")
      0
    ChangedKey(fp, file) ->
      eprintln(s"fettle: ${r.name}: the host now presents $fp, not the key $file lists for it; if the change is expected, remove the old line (`ssh-keygen -R`) and trust it again")
      1
    UnknownKey(fp, file) ->
      println(s"${r.name}: $fp")
      if !r.yes
        print(s"Add this key to $file? [y/N] ")
        val answer = io.readLine().getOrElse("").trim.toLower
        if answer != "y" && answer != "yes"
          eprintln("fettle: nothing recorded")
          return 1
      trustHostKey(reach.target, config, fp) match
        Ok(_) ->
          println(s"${r.name}: recorded in $file")
          0
        Err(e) ->
          eprintln(s"fettle: ${e.message}")
          1
