module dev.avinlang.fettle.engine

import avin.fs
import avin.process
import dev.avinlang.fettle.graph.{IntV, PathV, SecretV, StrV, Value}

// The text of a secret, read on the operator's machine when a run needs it: `secret.literal` and
// `secret.concat` from the values they were made of, `secret.env` from the environment,
// `secret.file` from a local file (`~/` standing for the home directory), `secret.command` from
// what a local `/bin/sh` command prints, its last line end dropped, and `secret.vault` through
// `vault`, which is given the vault's path and the secret's name. A secret's text is never printed;
// an error names where it was to come from, never what it holds.
reveal(
    v: Value,
    vault: (string, string) -> Result[string, string] = (f, _) -> Err(s"the vault `$f` is not open")
) -> Result[string, string] = v match
  StrV(t) -> Ok(t)
  PathV(p) -> Ok(p)
  IntV(n) -> Ok(s"$n")
  SecretV("literal", parts) -> joined(parts, vault)
  SecretV("concat", parts) -> joined(parts, vault)
  SecretV(source, _) if source.startsWith("env ") ->
    val name = source.stripPrefix("env ")
    process.env(name) match
      Some(t) -> Ok(t)
      None -> Err(s"the secret from the environment variable `$name` is not set")
  SecretV(source, _) if source.startsWith("file ") ->
    val file = homeExpanded(source.stripPrefix("file "))
    fs.readText(file).mapErr(e -> s"the secret file `$file` cannot be read: ${e.message}")
  SecretV(source, _) if source.startsWith("command ") ->
    val text = source.stripPrefix("command ")
    process.Command("/bin/sh", "-c", text).output() match
      Ok(out) -> Ok(if out.endsWith("\n") then out.slice(0, out.byteLength - 1) else out)
      Err(e) -> Err(s"the secret command `$text` failed: ${e.message}")
  SecretV(source, _) if source.startsWith("vault ") && source.lastIndexOf(" ") > 6 ->
    val space = source.lastIndexOf(" ")
    vault(source.slice(6, space), source.slice(space + 1, source.byteLength))
  SecretV(source, _) -> Err(s"the secret from `$source` cannot be read by this version of fettle")
  other -> Err(s"`${other.shown}` is not text")

// The texts of `parts` joined.
private joined(parts: List[Value], vault: (string, string) -> Result[string, string]) -> Result[string, string]
  val out = StringWriter()
  for p in parts
    out.write(reveal(p, vault)?)
  Ok(out.text)

// `file` with a leading `~/` replaced by the home directory.
private homeExpanded(file: string) -> string =
  if file.startsWith("~/") then process.env("HOME").getOrElse("") + file.slice(1, file.byteLength) else file
