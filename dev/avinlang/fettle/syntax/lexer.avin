module dev.avinlang.fettle.syntax

// The lexer: a `.fettle` file's text into tokens, with every lexical mistake reported and lexing
// carried on past it.
//
// Line structure follows the indentation, two spaces a level. A line indented further than the line
// before opens a block (`Indent`), one indented less closes blocks (`Dedent`) back to a level it
// lines up with, and the end of a line that holds something ends a statement (`Newline`). Blank
// lines and lines holding only a comment do not count. Inside `(`, `[` and `{` a line end is white
// space. A line indented further than the one before and beginning with `.` continues it, so a call
// chain may be broken across lines.

// What lexing a file gave: its tokens, ending with `EndOfFile`, and every mistake found; its
// comments, and the numbers of its blank lines, which the formatter keeps.
data Lexed(tokens: Vector[Token], diagnostics: Vector[Diagnostic], comments: Vector[Comment], blankLines: Vector[int])

// Lexes `text`, the contents of `file`.
lex(file: string, text: string) -> Lexed
  val l = Lexer(file, text)
  l.run()
  Lexed(l.tokens.toVector, l.diagnostics.toVector, l.comments.toVector, l.blankLines.toVector)

// What lexing a template gave: the tokens of its `@params(…)` line, its text and interpolations, and
// every mistake found.
data LexedTemplate(header: Vector[Token], body: List[Piece], diagnostics: Vector[Diagnostic])

// Lexes the template `text`, the contents of `file`. Its first line is `@params(…)`; the rest is text
// in which `${expr}` is an interpolation and `$${` writes `${`. Nothing else is an escape.
lexTemplate(file: string, text: string) -> LexedTemplate
  val l = Lexer(file, text)
  val (header, body) = l.runTemplate()
  LexedTemplate(header, body, l.diagnostics.toVector)

// The units a number may carry, with how many milliseconds or bytes one of each is.
private durationUnit(u: string) -> long = u match
  "ms" -> 1
  "s" -> 1000
  "m" -> 60000
  "h" -> 3600000
  "d" -> 86400000
  _ -> 0

private sizeUnit(u: string) -> long = u match
  "B" -> 1
  "kB" -> 1000
  "MB" -> 1000000
  "GB" -> 1000000000
  "TB" -> 1000000000000
  "KiB" -> 1024
  "MiB" -> 1048576
  "GiB" -> 1073741824
  "TiB" -> 1099511627776
  _ -> 0

// The number of bytes UTF-8 takes for `c`.
private encodedLength(c: char) -> int
  val code = int(c)
  if code < 0x80 then return 1
  if code < 0x800 then return 2
  if code < 0x10000 then 3 else 4

private isNameStart(c: char) -> bool = c.isLetter || c == '_'

private isNameChar(c: char) -> bool = c.isLetterOrDigit || c == '_'

// The operators of two and three characters, longest first; any other punctuation is one character.
private val longSymbols: Vector[string] = ["..<", "->", "==", "!=", "<=", ">=", "&&", "||", ".."]

private val singleSymbols: string = "()[]{},.:;=+-*/%<>!|?@"

// The largest value a `long` holds.
private val maxLong: long = 9223372036854775807

class Lexer(val file: string, val text: string)
  val tokens = Buffer[Token]()
  val diagnostics = Buffer[Diagnostic]()
  val comments = Buffer[Comment]()
  val blankLines = Buffer[int]()
  private val n: int = text.byteLength
  private var at = 0
  private var line = 1
  private var column = 1
  // The indentation of each open block, outermost first.
  private val levels = Buffer[int]()
  // The brackets open on the current logical line, each with where it opened.
  private val open = Buffer[(char, Span)]()

  // --- Reading characters -------------------------------------------------------------------

  private atEnd -> bool = at >= n

  private peek() -> char = text.charAt(at)

  // The character `k` bytes on, or a NUL past the end.
  private peekAt(k: int) -> char = if at + k < n then text.charAt(at + k) else '\u{0}'

  private pos() -> Pos = Pos(at, line, column)

  private advance()
    val c = text.charAt(at)
    at += encodedLength(c)
    if c == '\n'
      line += 1
      column = 1
    else
      column += 1

  private spanFrom(start: Pos) -> Span = Span(file, start, pos())

  private error(code: string, message: string, span: Span, label: string = "", help: string = "")
    diagnostics += Diagnostic(code, message, span, label, [], help)

  // --- Line structure -----------------------------------------------------------------------

  run()
    levels += 0
    var first = true
    while !atEnd
      // At the start of a line, outside brackets.
      val start = pos()
      var width = 0
      var tab = false
      while !atEnd && (peek() == ' ' || peek() == '\t')
        if peek() == '\t' then tab = true
        width += 1
        advance()
      if atEnd then break
      val c = peek()
      if c == '\n' || c == '\r'
        blankLines += line
        skipLineEnd()
        continue
      if c == '/' && peekAt(1) == '/'
        skipComment(true)
        continue
      if tab
        error("E0101", "indentation uses a tab", spanFrom(start), "a tab", "indent with two spaces a level")
        // Read as one level in where it is indented at all, so the one mistake is reported once.
        width = if width > levels.last then levels.last + 2 else levels.last
      if !first && c == '.' && peekAt(1) != '.' && width > levels.last
        // A continuation: the line carries on the statement before.
        lexLine()
        continue
      if !first then emitNewline()
      indentTo(width, start)
      first = false
      lexLine()
    if !first then emitNewline()
    val end = pos()
    while levels.length > 1
      levels.remove(levels.length - 1)
      tokens += Dedent(Span(file, end, end))
    tokens += EndOfFile(Span(file, end, end))

  private skipLineEnd()
    if peek() == '\r' then advance()
    if !atEnd && peek() == '\n' then advance()

  // Reads a comment up to its line end, keeping it for the formatter.
  private skipComment(ownLine: bool)
    val start = pos()
    val from = at
    while !atEnd && peek() != '\n' && peek() != '\r'
      advance()
    comments += Comment(text.slice(from, at).trim, spanFrom(start), ownLine)

  // Lexes a template: the tokens of its first line, then its text and interpolations.
  runTemplate() -> (Vector[Token], List[Piece])
    lexLine()
    val e = pos()
    tokens += EndOfFile(Span(file, e, e))
    val parts = Buffer[Piece]()
    val buf = StringWriter()
    var chunkStart = pos()
    while !atEnd
      val c = peek()
      if c == '$' && peekAt(1) == '$' && peekAt(2) == '{'
        advance()
        advance()
        advance()
        buf.write("${")
      else if c == '$' && peekAt(1) == '{'
        flushChunk(parts, buf, chunkStart)
        val (hole, closed) = lexHole(true)
        parts += hole
        chunkStart = pos()
        if !closed then break
      else
        if c != '\r' then buf.writeChar(c)
        advance()
    flushChunk(parts, buf, chunkStart)
    (tokens.toVector, parts.toList)

  private emitNewline()
    if tokens.length == 0 then return
    tokens.last match
      Newline(_) | Indent(_) | Dedent(_) -> ()
      t ->
        val e = t.extent.end
        tokens += Newline(Span(file, e, e))

  // Opens or closes blocks so the current line, indented `width` spaces, is in its own.
  private indentTo(width: int, start: Pos)
    val here = spanFrom(start)
    val top = levels.last
    if width > top
      if width != top + 2
        error("E0102", s"this line is indented ${width - top} spaces past the line above, and a block is indented 2", here, s"$width spaces", s"indent it ${top + 2} spaces")
      levels += width
      tokens += Indent(here)
    else if width < top
      while levels.length > 1 && levels.last > width
        // A line between this block's indentation and the one outside it belongs to this block,
        // misaligned: the block stays open, at the line's indentation, so its statements stay in it.
        if levels(levels.length - 2) < width
          error("E0103", s"this line's indentation, $width spaces, lines up with no enclosing block", here, s"$width spaces", s"indent it ${levels.last} spaces")
          levels(levels.length - 1) = width
          return
        levels.remove(levels.length - 1)
        tokens += Dedent(here)

  // Lexes the tokens of one line; brackets left open carry it on over the line ends that follow.
  private lexLine()
    while !atEnd
      val c = peek()
      if c == ' ' || c == '\t'
        advance()
      else if c == '\r' || c == '\n'
        if open.isEmpty
          skipLineEnd()
          return
        skipLineEnd()
      else if c == '/' && peekAt(1) == '/'
        skipComment(false)
      else
        lexToken(tokens, open)
    for (b, s) in open
      error("E0104", s"`$b` is never closed", s, "opened here", s"close it with `${closer(b)}`")
    open.clear()

  // --- Tokens -------------------------------------------------------------------------------

  // Lexes one token at `at` into `out`, keeping `brackets`, the brackets open around it.
  private lexToken(out: Buffer[Token], brackets: Buffer[(char, Span)])
    val start = pos()
    val c = peek()
    if c == 's' && peekAt(1) == 'h' && peekAt(2) == '"' && !(peekAt(3) == '"' && peekAt(4) == '"')
      advance()
      advance()
      val (parts, _) = lexString(start)
      out += ShellLit(parts, spanFrom(start))
    else if isNameStart(c)
      val from = at
      while !atEnd && isNameChar(peek())
        advance()
      out += Word(text.slice(from, at), spanFrom(start))
    else if c.isDigit
      lexNumber(out, start)
    else if c == '"'
      val (parts, multi) = lexString(start)
      out += StringLit(parts, multi, spanFrom(start))
    else
      lexSymbol(out, brackets, start)

  private lexSymbol(out: Buffer[Token], brackets: Buffer[(char, Span)], start: Pos)
    for s in longSymbols
      if text.startsWith(s, at)
        for _ in 0..<s.byteLength
          advance()
        out += Symbol(s, spanFrom(start))
        return
    val c = peek()
    if singleSymbols.contains(s"$c")
      advance()
      val here = spanFrom(start)
      if c == '(' || c == '[' || c == '{'
        brackets += (c, here)
      else if c == ')' || c == ']' || c == '}'
        if brackets.isEmpty
          error("E0105", s"`$c` closes nothing", here, "no bracket is open here", "remove it")
        else
          val (b, opened) = brackets.last
          if closer(b) != c
            diagnostics += Diagnostic("E0106", s"`$c` does not close `$b`", here, s"expected `${closer(b)}`", [], "", false, [(opened, "opened here")])
          brackets.remove(brackets.length - 1)
      out += Symbol(s"$c", here)
    else
      advance()
      error("E0107", s"`$c` cannot appear in a program", spanFrom(start), "unexpected character")

  // Lexes a number: decimal, `0o` octal (a mode), or decimal with a duration or size unit.
  private lexNumber(out: Buffer[Token], start: Pos)
    if peek() == '0' && peekAt(1) == 'o'
      advance()
      advance()
      var value: long = 0
      var digits = 0
      var tooLarge = false
      while !atEnd && (('0' <= peek() <= '9') || peek() == '_' || peek().isLetter)
        val d = peek()
        if '0' <= d <= '7'
          if value > (maxLong - 7) / 8 then tooLarge = true else value = value * 8 + long(int(d) - int('0'))
          digits += 1
        else if d != '_'
          advance()
          error("E0108", s"`$d` is not an octal digit", spanFrom(start), "in this mode", "a mode's digits are 0 to 7")
          return
        advance()
      val here = spanFrom(start)
      if digits == 0
        error("E0108", "`0o` needs octal digits after it", here, "no digits", "write a mode such as `0o644`")
      else if tooLarge
        error("E0109", "this mode is too large", here, "does not fit 64 bits")
      out += ModeLit(value, here)
      return
    var value: long = 0
    var tooLarge = false
    while !atEnd && (peek().isDigit || peek() == '_')
      val d = peek()
      if d != '_'
        val digit = long(int(d) - int('0'))
        if value > (maxLong - digit) / 10 then tooLarge = true else value = value * 10 + digit
      advance()
    if !atEnd && peek().isLetter
      val unitStart = at
      while !atEnd && peek().isLetter
        advance()
      val u = text.slice(unitStart, at)
      val here = spanFrom(start)
      val written = text.slice(start.offset, at)
      val ms = durationUnit(u)
      val bytes = sizeUnit(u)
      if ms > 0
        if tooLarge || value > maxLong / ms
          error("E0109", s"the duration `$written` is too large", here, "does not fit 64 bits")
          out += DurationLit(0, written, here)
        else
          out += DurationLit(value * ms, written, here)
      else if bytes > 0
        if tooLarge || value > maxLong / bytes
          error("E0109", s"the size `$written` is too large", here, "does not fit 64 bits")
          out += SizeLit(0, written, here)
        else
          out += SizeLit(value * bytes, written, here)
      else
        error("E0110", s"`$u` is not a unit", here, "unknown unit", "a duration ends in ms, s, m, h or d; a size in B, kB, MB, GB, TB, KiB, MiB, GiB or TiB")
        out += IntLit(value, here)
      return
    val here = spanFrom(start)
    if tooLarge then error("E0109", "this number is too large", here, "does not fit 64 bits", s"the largest int is $maxLong")
    out += IntLit(value, here)

  // --- Strings ------------------------------------------------------------------------------

  // Lexes a string whose opening quote is at `at` (after any `sh`), answering its pieces and whether
  // it was `"""…"""`.
  private lexString(start: Pos) -> (List[Piece], bool)
    if peek() == '"' && peekAt(1) == '"' && peekAt(2) == '"'
      return (lexMultiline(start), true)
    advance()
    val parts = Buffer[Piece]()
    val buf = StringWriter()
    var chunkStart = pos()
    while true
      if atEnd || peek() == '\n' || peek() == '\r'
        error("E0111", "this string is not closed on its line", spanFrom(start), "string begins here", "end it with `\"`, or use `\"\"\"` for text over several lines")
        break
      val c = peek()
      if c == '"'
        advance()
        break
      if c == '\\'
        readEscape(buf)
      else if c == '$' && peekAt(1) == '{'
        flushChunk(parts, buf, chunkStart)
        val (hole, closed) = lexHole(false)
        parts += hole
        chunkStart = pos()
        // The hole's error stands for the string too.
        if !closed then break
      else
        buf.writeChar(c)
        advance()
    flushChunk(parts, buf, chunkStart)
    (parts.toList, false)

  private flushChunk(parts: Buffer[Piece], buf: StringWriter, chunkStart: Pos)
    val t = buf.text
    if !t.isEmpty
      parts += Chunk(t, spanFrom(chunkStart))
    buf.clear()

  // Reads a backslash escape into `buf`.
  private readEscape(buf: StringWriter)
    val start = pos()
    advance()
    if atEnd || peek() == '\n'
      error("E0112", "a backslash ends the line", spanFrom(start), "nothing to escape")
      return
    val e = peek()
    advance()
    e match
      'n' -> buf.writeChar('\n')
      't' -> buf.writeChar('\t')
      'r' -> buf.writeChar('\r')
      '0' -> buf.writeChar('\u{0}')
      '\\' -> buf.writeChar('\\')
      '"' -> buf.writeChar('"')
      '$' -> buf.writeChar('$')
      'u' ->
        if atEnd || peek() != '{'
          error("E0112", "`\\u` needs a code point in braces", spanFrom(start), "as `\\u{1F600}`")
          return
        advance()
        var code = 0
        var digits = 0
        while !atEnd && peek() != '}' && peek() != '"' && peek() != '\n'
          val h = peek()
          val d = if '0' <= h <= '9' then int(h) - int('0') else if 'a' <= h <= 'f' then int(h) - int('a') + 10 else if 'A' <= h <= 'F' then int(h) - int('A') + 10 else -1
          if d < 0 || digits >= 6
            code = -1
          else if code >= 0
            code = code * 16 + d
          digits += 1
          advance()
        if !atEnd && peek() == '}' then advance()
        if code < 0 || digits == 0 || code > 0x10ffff || (0xd800 <= code <= 0xdfff)
          error("E0112", "this is not a Unicode code point", spanFrom(start), "bad escape", "write one to six hex digits, as `\\u{e9}`")
        else
          buf.writeChar(char(code))
      _ -> error("E0112", s"`\\$e` is not an escape", spanFrom(start), "unknown escape", "the escapes are \\n \\t \\r \\0 \\\\ \\\" \\$ and \\u{…}")

  // Lexes `${…}` at `at`: the tokens of the expression up to the `}` that closes it. A hole in a
  // one-line string ends with its line.
  private lexHole(multiline: bool) -> (Piece, bool)
    val start = pos()
    advance()
    advance()
    val inner = Buffer[Token]()
    val brackets = Buffer[(char, Span)]()
    var closed = false
    while true
      if atEnd || (!multiline && (peek() == '\n' || peek() == '\r'))
        error("E0113", "`${` is never closed", Span(file, start, Pos(start.offset + 2, start.line, start.column + 2)), "opened here", "close it with `}`")
        break
      val c = peek()
      if c == ' ' || c == '\t' || c == '\n' || c == '\r'
        advance()
      else if c == '}' && brackets.isEmpty
        advance()
        closed = true
        break
      else
        lexToken(inner, brackets)
    val here = spanFrom(start)
    if closed && inner.isEmpty
      error("E0114", "`${}` holds no expression", here, "empty interpolation")
    (Hole(inner.toList, here), closed)

  // Lexes `"""…"""`. Text that begins with a line end drops it, and the closing `"""` alone on its
  // line sets a margin: that many leading spaces are taken off every line, and the line end before the
  // closing line is dropped.
  private lexMultiline(start: Pos) -> List[Piece]
    advance()
    advance()
    advance()
    val close = text.indexOf("\"\"\"", at)
    var margin = 0
    var stripLast = false
    if close >= 0
      var k = close - 1
      while k >= at && text.byteAt(k) == byte(int(' '))
        k -= 1
      if k >= at && text.byteAt(k) == byte(int('\n'))
        margin = close - k - 1
        stripLast = true
    if !atEnd && peek() == '\n' then advance()
    else if !atEnd && peek() == '\r' && peekAt(1) == '\n'
      advance()
      advance()
    val parts = Buffer[Piece]()
    val buf = StringWriter()
    var chunkStart = pos()
    var lineStart = true
    while true
      if atEnd
        error("E0111", "this text is not closed", spanFrom(start), "text begins here", "end it with `\"\"\"`")
        break
      if at == close
        advance()
        advance()
        advance()
        break
      if lineStart
        var k = 0
        while k < margin && !atEnd && peek() == ' ' && at < close
          advance()
          k += 1
        lineStart = false
        continue
      val c = peek()
      if c == '\\'
        readEscape(buf)
      else if c == '$' && peekAt(1) == '{'
        flushChunk(parts, buf, chunkStart)
        val (hole, closed) = lexHole(true)
        parts += hole
        chunkStart = pos()
        if !closed then break
      else
        if c == '\n'
          lineStart = true
          // The line end before the closing line belongs to the layout, not the text.
          if !(stripLast && onlySpacesUntil(at + 1, close))
            buf.writeChar(c)
        else if c != '\r'
          buf.writeChar(c)
        advance()
    flushChunk(parts, buf, chunkStart)
    parts.toList

  // Whether only spaces lie from `from` up to `until`.
  private onlySpacesUntil(from: int, until: int) -> bool
    var k = from
    while k < until
      if text.byteAt(k) != byte(int(' ')) then return false
      k += 1
    true

// The bracket that closes `b`.
closer(b: char) -> char = b match
  '(' -> ')'
  '[' -> ']'
  _ -> '}'
