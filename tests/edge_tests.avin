module tests

// The edge cases of phase 1a, through the parser: indentation, interpolation, duplicates, ordering
// ties, triggers on what is not declared, and where a secret may flow.

@test("indentation mistakes are each reported at their line, and the rest still checks")
edgeIndentation()
  assertEq(errorsIn(["role r()", "   package \"a\"", "  package \"b\""]), "main.fettle:2:1 E0102 this line is indented 3 spaces past the line above, and a block is indented 2\nmain.fettle:3:1 E0103 this line's indentation, 2 spaces, lines up with no enclosing block")
  assertEq(errorsIn(["role r()", "\tpackage \"a\""]), "main.fettle:2:1 E0101 indentation uses a tab")

@test("interpolation: a lone dollar is text, an escaped one too, nested strings and any scalar")
edgeInterpolation()
  assertEq(graphText(["role r()", "  file \"/a\"", "    content = \"$5 \\${x} ${\"in${1 + 2}\"} ${0o640} ${30s}\""]), "1. file \"/a\"\n     content = \"$5 ${x} in3 0o640 30s\"\n")
  assertEq(errorsIn(["role r(xs: List[string])", "  package \"${xs}\""]), "main.fettle:2:14 E0203 a `List[string]` cannot be interpolated into a string")
  assertEq(syntaxOf("val a = \"${}\"\n"), "t.fettle:1:10 E0114 `${}` holds no expression")

@test("identical duplicates from two roles merge; differing ones conflict, showing both")
edgeDuplicates()
  val same = ["role a()", "  package \"git\"", "", "role b()", "  package \"git\"", "", "role r()", "  a()", "  b()"]
  assertEq(graphText(same), "1. package \"git\"\n")
  val differ = ["role a()", "  file \"/x\"", "    mode = 0o600", "", "role b()", "  file \"/x\"", "    mode = 0o644", "", "role r()", "  a()", "  b()"]
  assertEq(graphText(differ), "main.fettle:6:3 E0401 `file /x` is declared twice with different fields")

@test("resources with no order between them keep declaration order")
edgeOrderingTies()
  assertEq(graphText(["role r()", "  package \"c\"", "  package \"a\"", "  package \"b\""]), "1. package \"c\"\n2. package \"a\"\n3. package \"b\"\n")
  val after = ["role r()", "  val c = package \"c\"", "  package \"a\"", "    after b", "  val b = package \"b\""]
  assertEq(errorsIn(after), "main.fettle:4:11 E0201 there is no value `b`")

@test("a trigger on a resource that is not declared is an unknown name at check")
triggerOnUndeclared()
  assertEq(errorsIn(["role r()", "  service \"s\"", "    on conf -> restart"]), "main.fettle:3:8 E0201 there is no value `conf`")

// A module `roles` whose declarations name its own types, used from the root module.
val rolesLib: string = src(["module roles", "", "data Person(name: string)", "", "data Team(lead: Person, members: List[Person])", "", "lead(t: Team) -> Person = t.lead", "", "role people(members: List[Person])", "  for p in members", "    user p.name"])

@test("a declaration of one module reached from another resolves its types where it is written")
crossModuleScopes()
  val team = src(["import roles.{Person}", "", "val team = [Person(\"ana\")]"])
  val main = src(["import roles.{Person, Team, lead, people}", "", "group all1", "  host h at \"10.0.0.1\"", "", "apply all -> people(team)", "apply all -> people([lead(Team(Person(\"bo\"), team))])"])
  // `main.fettle` is checked before `team.fettle`, and reaches `team` first.
  assertEq(projectDiags([("roles/lib.fettle", rolesLib), ("main.fettle", main), ("team.fettle", team)]), "")
  // A file that imports a name only another file's value uses is still told it does not use it.
  val unused = src(["import roles.{Person}", "", "val n = 1"])
  assertEq(projectDiags([("roles/lib.fettle", rolesLib), ("a.fettle", unused)]), "a.fettle:1:15 W0217 `Person` is imported and never used")
  // A type a file does not import is still unknown there.
  assertEq(projectDiags([("roles/lib.fettle", rolesLib), ("a.fettle", src(["data X(p: Person)"]))]), "a.fettle:1:11 E0201 there is no type `Person`")

@test("a secret reaches a command only on standard input")
secretIntoCommand()
  assertEq(errorsIn(["role r(k: secret)", "  command \"c\"", "    run = sh\"login ${k}\"", "    always = true"]), "main.fettle:3:22 E0209 a secret cannot be in a command's argument list")
  assertEq(errorsIn(["role r(k: secret)", "  command \"c\"", "    run = sh\"login\".stdin(secret.concat(\"pw=\", k))", "    always = true"]), "")

// The graph of a role whose one command runs `sh"…"` written as `run`, after `vals`.
shGraph(vals: Vector[string], run: string) -> string = graphText(["role r()"] ++ vals ++ ["  command \"c\"", s"    run = $run", "    always = true"])

// The graph `shGraph` gives when the command's shell text is `text`, as the graph quotes it.
shExpected(text: string) -> string = s"1. command \"c\"\n     run = sh(\"${text.replace("\\", "\\\\").replace("\"", "\\\"")}\")\n     always = true\n"

@test("each interpolation of sh\"…\" is quoted as one word; its literal text stays shell")
shInterpolationQuoted()
  assertEq(shGraph(["  val x = \"it's; rm -rf /\""], "sh\"echo ${x} | wc -c\""), shExpected("echo 'it'\\''s; rm -rf /' | wc -c"))
  assertEq(shGraph(["  val x = \"plain\""], "sh\"echo ${x}\""), shExpected("echo plain"))
  assertEq(shGraph(["  val x = \"\""], "sh\"test -z ${x}\""), shExpected("test -z ''"))
  assertEq(shGraph(["  val x = \"$HOME `id` \\\\\""], "sh\"echo ${x}\""), shExpected("echo '$HOME `id` \\'"))
  assertEq(shGraph(["  val x = \"é 日本\""], "sh\"echo ${x}\""), shExpected("echo 'é 日本'"))
  assertEq(shGraph([], "sh\"echo ${1 + 2} ${\"a b\"}\""), shExpected("echo 3 'a b'"))
  assertEq(shGraph(["  val x = \"a b\""], "sh\"echo \\\"${x}\\\" $HOME\""), shExpected("echo \"'a b'\" $HOME"))

@test("a NUL in an interpolation of sh\"…\" is an evaluation error")
shInterpolationNul()
  assertEq(shGraph(["  val x = \"a\\0b\""], "sh\"echo ${x}\""), "main.fettle:4:21 E0320 the word `a\\0b` holds a NUL character, which no shell word can carry")
