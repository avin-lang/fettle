module tests

import dev.avinlang.fettle.syntax.{BinaryE, BindP, Decl, ExprP, FieldE, ForS, IfE, Import, ListE, ModeE, OnS, SourceFile, StrE, TextP, UnaryE}
import dev.avinlang.fettle.fmt.{format, showExpr}

@test("example 2.2's role prints as the design writes it")
people()
  val p = FieldE(nm("p"), "name", sp(1))
  val decls: List[Decl] = [
    record("Person", [param("name", ty("string")), param("keys", tyOf("List", [ty("string")])), paramD("admin", ty("bool"), nm("false"))]),
    role("people", [param("members", tyOf("List", [ty("Person")])), param("departed", tyOf("List", [ty("string")]))], [
      res("group", str("admins"), []),
      ForS(BindP("p", sp(1)), nm("members"), [res("user", p, [
        fieldS("shell", str("/bin/bash")),
        fieldS("groups", IfE(FieldE(nm("p"), "admin", sp(1)), ListE([str("admins")], sp(1)), ListE([], sp(1)), sp(1))),
        fieldS("authorizedKeys", FieldE(nm("p"), "keys", sp(1)))
      ])], sp(1)),
      ForS(BindP("name", sp(1)), nm("departed"), [res("user", nm("name"), [fieldS("present", nm("false"))])], sp(1)),
      res("file", str("/etc/sudoers.d/admins"), [
        fieldS("content", str("%admins ALL=(ALL) NOPASSWD: ALL\n")),
        fieldS("mode", ModeE(288, sp(1))),
        fieldS("validate", call("cmd", [str("visudo"), str("-cf"), nm("staged")]))
      ])
    ])
  ]
  assertEq(format(source(decls, "roles")), "module roles\n\ndata Person(name: string, keys: List[string], admin: bool = false)\n\nrole people(members: List[Person], departed: List[string])\n  group \"admins\"\n  for p in members\n    user p.name\n      shell = \"/bin/bash\"\n      groups = if p.admin then [\"admins\"] else []\n      authorizedKeys = p.keys\n  for name in departed\n    user name\n      present = false\n  file \"/etc/sudoers.d/admins\"\n    content = \"%admins ALL=(ALL) NOPASSWD: ALL\\n\"\n    mode = 0o440\n    validate = cmd(\"visudo\", \"-cf\", staged)\n")

@test("imports print with their names, and declarations are separated by one blank line")
formattedImports()
  val f = source([valD("a", num(1)), valD("b", num(2))], "", [Import("roles", [("Site", sp(1)), ("webServer", sp(1))], sp(1))])
  assertEq(format(f), "import roles.{Site, webServer}\n\nval a = 1\n\nval b = 2\n")

@test("operators are parenthesised only where precedence needs it")
precedence()
  val a = nm("a")
  val b = nm("b")
  val c = nm("c")
  assertEq(showExpr(BinaryE("*", BinaryE("+", a, b, sp(1)), c, sp(1))), "(a + b) * c")
  assertEq(showExpr(BinaryE("+", a, BinaryE("*", b, c, sp(1)), sp(1))), "a + b * c")
  assertEq(showExpr(BinaryE("-", a, BinaryE("-", b, c, sp(1)), sp(1))), "a - (b - c)")
  assertEq(showExpr(BinaryE("-", BinaryE("-", a, b, sp(1)), c, sp(1))), "a - b - c")
  assertEq(showExpr(BinaryE("&&", BinaryE("||", a, b, sp(1)), c, sp(1))), "(a || b) && c")
  assertEq(showExpr(UnaryE("!", BinaryE("==", a, b, sp(1)), sp(1))), "!(a == b)")

@test("strings print with their escapes, and an interpolation as written")
formattedStrings()
  assertEq(showExpr(StrE([TextP("a\"b\\c\td\n$x ${")], false, sp(1))), "\"a\\\"b\\\\c\\td\\n$x \\${\"")
  assertEq(showExpr(StrE([ExprP(FieldE(nm("tls"), "path", sp(1))), TextP("/"), ExprP(nm("d"))], false, sp(1))), "\"${tls.path}/${d}\"")
  assertEq(showExpr(StrE([TextP("$")], false, sp(1))), "\"$\"")
  assertEq(showExpr(ModeE(0, sp(1))), "0o0")

@test("comments are kept, on their own lines and at the ends of lines, at the level of what follows")
formattedComments()
  val text = src(["// a file", "module roles", "", "// a role", "role r()", "  // first", "  package \"a\" // the editor", "", "  // second", "  package \"b\"", "// at the end"])
  assertEq(reformat(text), text)
  assertEq(reformat(src(["role r()", "  package \"a\"", "    // under", "  package \"b\""])), src(["role r()", "  package \"a\"", "  // under", "  package \"b\""]))

@test("blank lines: one where the source had any inside a block, one between declarations")
formattedBlankLines()
  assertEq(reformat(src(["role r()", "  package \"a\"", "", "", "", "  package \"b\"", "  package \"c\""])), src(["role r()", "  package \"a\"", "", "  package \"b\"", "  package \"c\""]))
  assertEq(reformat(src(["val a = 1", "role r()", "  package \"a\"", "val b = 2", "val c = 3"])), src(["val a = 1", "", "role r()", "  package \"a\"", "", "val b = 2", "val c = 3"]))
  assertEq(reformat(src(["apply all -> a()", "apply all -> b()", "val c = 1"])), src(["apply all -> a()", "apply all -> b()", "", "val c = 1"]))

@test("a line over 100 characters breaks at its call, list or map, one item a line")
formattedLongLines()
  val list = "val team = [Person(\"ana\", [\"ssh-ed25519 AAAA ana@laptop\"], admin = true), Person(\"bo\", [\"ssh-ed25519 BBBB bo@desk\"])]\n"
  assertEq(reformat(list), src(["val team = [", "  Person(\"ana\", [\"ssh-ed25519 AAAA ana@laptop\"], admin = true),", "  Person(\"bo\", [\"ssh-ed25519 BBBB bo@desk\"]),", "]"]))
  val call = "apply web as h -> webServer(Site(h.vars.domain), certificate = local(\"certs/${h.vars.domain}.crt\"), key = secret.file(\"~/secrets/${h.vars.domain}.key\"))\n"
  assertEq(reformat(call), src(["apply web as h ->", "  webServer(", "    Site(h.vars.domain),", "    certificate = local(\"certs/${h.vars.domain}.crt\"),", "    key = secret.file(\"~/secrets/${h.vars.domain}.key\")", "  )"]))
  val fitsBelow = "apply web as h -> webServer(Site(h.vars.domain), certificate = local(\"certs/${h.vars.domain}.crt\"), k = 1)\n"
  assertEq(reformat(fitsBelow), src(["apply web as h ->", "  webServer(Site(h.vars.domain), certificate = local(\"certs/${h.vars.domain}.crt\"), k = 1)"]))
  val map = "val m = { \"aaaaaaaaaaaaaaaaaaaa\": 1, \"bbbbbbbbbbbbbbbbbbbbbbbbbbbb\": 2, \"cccccccccccccccccccccccccc\": 3, \"d\": 4 }\n"
  assertEq(reformat(map), src(["val m = {", "  \"aaaaaaaaaaaaaaaaaaaa\": 1,", "  \"bbbbbbbbbbbbbbbbbbbbbbbbbbbb\": 2,", "  \"cccccccccccccccccccccccccc\": 3,", "  \"d\": 4,", "}"]))
  val exact = s"val x = \"${"a".repeat(89)}\"\n"
  assertEq(reformat(exact), exact)
  for t in [list, call, map]
    assertEq(reformat(reformat(t)), reformat(t))

@test("settings and hosts of a group stay in the order written")
formattedGroupOrder()
  val text = src(["group web", "  workers = 8", "  host web1 at \"10.0.0.1\"", "    domain = \"a\"", "  rollout = AllAtOnce"])
  assertEq(reformat(text), text)
