module tests

import dev.avinlang.fettle.syntax.{Pos, Span}
import dev.avinlang.fettle.graph.{After, GraphBuilder, ListV, ModeV, Node, PathV, Reference, ResourceId, StrV, Value, showGraph}

// A span on `line` of `g.fettle`.
at(line: int) -> Span = Span("g.fettle", Pos(0, line, 1), Pos(0, line, 2))

node(kind: string, title: string, line: int, fields: List[(string, Value)] = []) -> Node =
  Node(ResourceId(kind, title), fields, at(line), "")

// The resources of a finished graph in order, as `kind title`.
orderOf(b: GraphBuilder) -> string = b.finish().nodes.map(n -> n.id.shown).mkString(", ")

errorsOf(b: GraphBuilder) -> string =
  b.diagnostics.map(d -> s"${d.span.start.line} ${d.code} ${d.message}").mkString("; ")

@test("with no edges, resources keep their declaration order")
declarationOrder()
  val b = GraphBuilder()
  b.add(node("package", "nginx", 1))
  b.add(node("service", "nginx", 2))
  b.add(node("package", "git", 3))
  assertEq(orderOf(b), "package nginx, service nginx, package git")
  assertEq(errorsOf(b), "")

@test("an edge against declaration order moves only what it must, and ties keep declaration order")
orderingTies()
  val b = GraphBuilder()
  val a = b.add(node("package", "a", 1))
  val c = b.add(node("package", "c", 2))
  val d = b.add(node("package", "d", 3))
  val e = b.add(node("package", "e", 4))
  b.order(e, a, After, at(1))
  assertEq(orderOf(b), "package c, package d, package e, package a")

@test("identical duplicates merge into the first declaration")
duplicateMerge()
  val b = GraphBuilder()
  val first = b.add(node("package", "git", 1, [("present", StrV("yes"))]))
  b.add(node("package", "curl", 2))
  val second = b.add(node("package", "git", 7, [("present", StrV("yes"))]))
  assertEq(first, second)
  assertEq(orderOf(b), "package git, package curl")
  assertEq(errorsOf(b), "")

@test("conflicting duplicates are an error showing both positions and the fields that differ")
duplicateConflict()
  val b = GraphBuilder()
  b.add(node("file", "/etc/a", 3, [("mode", ModeV(420)), ("owner", StrV("root"))]))
  b.add(node("file", "/etc/a", 9, [("mode", ModeV(384)), ("owner", StrV("root"))]))
  b.add(node("file", "/etc/b", 10, [("mode", ModeV(384))]))
  b.add(node("file", "/etc/b", 11, []))
  assertEq(errorsOf(b), "9 E0401 `file /etc/a` is declared twice with different fields; 11 E0401 `file /etc/b` is declared twice with different fields")
  val d = b.diagnostics(0)
  assertEq(d.secondary.map((s, l) -> s"${s.start.line} $l").mkString(""), "3 first declared here")
  assertEq(d.notes.mkString("; "), "`mode`: 0o644 there, 0o600 here")
  assertEq(b.diagnostics(1).notes.mkString("; "), "`mode`: 0o600 there, unset here")

@test("a duplicate that runs as another user conflicts")
duplicateUser()
  val b = GraphBuilder()
  b.add(Node(ResourceId("package", "x"), [], at(1), ""))
  b.add(Node(ResourceId("package", "x"), [], at(2), "postgres"))
  assertEq(errorsOf(b), "2 E0401 `package x` is declared twice with different fields")
  assertEq(b.diagnostics(0).notes.mkString(""), "`user`: the default user there, \"postgres\" here")

@test("a path comes after its nearest managed parent directory")
parentDirectory()
  val b = GraphBuilder()
  b.add(node("file", "/etc/nginx/tls/a.crt", 1))
  b.add(node("directory", "/etc/nginx", 2))
  b.add(node("directory", "/etc/nginx/tls", 3))
  assertEq(orderOf(b), "directory /etc/nginx, directory /etc/nginx/tls, file /etc/nginx/tls/a.crt")

@test("a file comes after the user and group it names, and a user after its groups")
owners()
  val b = GraphBuilder()
  b.add(node("file", "/srv/x", 1, [("owner", StrV("www")), ("group", StrV("web"))]))
  b.add(node("user", "www", 2, [("groups", ListV([StrV("admins")]))]))
  b.add(node("group", "web", 3))
  b.add(node("group", "admins", 4))
  assertEq(orderOf(b), "group web, group admins, user www, file /srv/x")
  assertEq(errorsOf(b), "")

@test("a symlink comes after its managed target")
symlinkTarget()
  val b = GraphBuilder()
  b.add(node("symlink", "/etc/l", 1, [("target", PathV("/opt/t"))]))
  b.add(node("file", "/opt/t", 2))
  assertEq(orderOf(b), "file /opt/t, symlink /etc/l")

@test("a trigger orders the target after every source and is kept once")
triggers()
  val b = GraphBuilder()
  val svc = b.add(node("service", "nginx", 1))
  val conf = b.add(node("file", "/etc/nginx.conf", 2))
  val crt = b.add(node("file", "/etc/a.crt", 3))
  b.trigger([conf, crt], svc, "reload", at(4))
  val g = b.finish()
  assertEq(g.nodes.map(n -> n.id.shown).mkString(", "), "file /etc/nginx.conf, file /etc/a.crt, service nginx")
  assertEq(g.triggers.map(t -> s"${t.sources} ${t.target} ${t.action}").mkString(""), "[0, 1] 2 reload")
  assertEq(showGraph(g).contains("triggers:\n  file /etc/nginx.conf, file /etc/a.crt -> service nginx reload\n"), true)

@test("a cycle is an error naming each edge and why it exists, and every resource is still in the graph")
cycles()
  val b = GraphBuilder()
  val a = b.add(node("package", "a", 1))
  val c = b.add(node("package", "c", 2))
  val d = b.add(node("package", "d", 3))
  b.order(a, c, Reference("x"), at(5))
  b.order(c, d, After, at(6))
  b.order(d, a, After, at(7))
  val g = b.finish()
  assertEq(g.nodes.length, 3)
  assertEq(errorsOf(b), "5 E0402 the resources form an ordering cycle: package a -> package c -> package d -> package a")
  assertEq(b.diagnostics(0).secondary.map((s, l) -> s"${s.start.line}: $l").mkString("; "), "5: `package c` after `package a`: its field `x` refers to it; 6: `package d` after `package c`: `after` says so; 7: `package a` after `package d`: `after` says so")

@test("a resource ordered after itself adds no edge")
selfEdge()
  val b = GraphBuilder()
  val a = b.add(node("package", "a", 1))
  b.order(a, a, After, at(2))
  assertEq(b.finish().edges.length, 0)
  assertEq(errorsOf(b), "")

@test("the graph prints each resource with its fields, in order")
printing()
  val b = GraphBuilder()
  b.add(node("file", "/etc/x", 1, [("content", StrV("a\nb")), ("mode", ModeV(416))]))
  assertEq(showGraph(b.finish()), "1. file \"/etc/x\"\n     content = \"a\\nb\"\n     mode = 0o640\n")
